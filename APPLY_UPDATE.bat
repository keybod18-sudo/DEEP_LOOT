@echo off
setlocal EnableExtensions
chcp 65001 >nul
pushd "%~dp0"
title DEEP LOOT - Apply Update
if not exist "package.json" (
  echo [ERROR] Put APPLY_UPDATE.bat in the DEEP_LOOT project root.
  pause
  popd
  endlocal
  exit /b 1
)
set "ROOT=%CD%"
set "SELF_FILE=%~f0"
set "TMP_ZIP=%TEMP%\deep_loot_apply_update.zip"
if not exist ".runtime\node\node.exe" (
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%ROOT%\tools\bootstrap-node.ps1"
  if errorlevel 1 goto :error
)
set "NODE_DIR=%ROOT%\.runtime\node"
set "PATH=%NODE_DIR%;%PATH%"
if not exist "%NODE_DIR%\npm.cmd" goto :error
echo [1/4] Applying snake, bat, and poison update...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command ^
  "$f=$env:SELF_FILE; $t=[IO.File]::ReadAllText($f); $m='__DEEP_LOOT_PAYLOAD__'; $i=$t.LastIndexOf($m); if($i -lt 0){throw 'Payload marker not found'}; $b=$t.Substring($i+$m.Length).Trim(); [IO.File]::WriteAllBytes($env:TMP_ZIP,[Convert]::FromBase64String($b)); Expand-Archive -LiteralPath $env:TMP_ZIP -DestinationPath $env:ROOT -Force"
if errorlevel 1 goto :error
del /q "%TMP_ZIP%" >nul 2>&1
if not exist "node_modules\.bin\tsc.cmd" (
  call "%NODE_DIR%\npm.cmd" install
  if errorlevel 1 goto :error
)
echo [2/4] Checking TypeScript...
call "%NODE_DIR%\npm.cmd" run check
if errorlevel 1 goto :error
echo [3/4] Checking locked assets...
"%NODE_DIR%\node.exe" "tools\verify-assets.mjs"
if errorlevel 1 goto :error
echo [4/4] Commit and push...
set "GITEXE="
if exist ".runtime\git\cmd\git.exe" set "GITEXE=%ROOT%\.runtime\git\cmd\git.exe"
if not defined GITEXE (
  where git >nul 2>&1
  if not errorlevel 1 set "GITEXE=git"
)
if defined GITEXE if exist ".git" (
  "%GITEXE%" add -A
  "%GITEXE%" diff --cached --quiet
  if errorlevel 1 (
    "%GITEXE%" commit -m "feat: add snake bat and poison status"
    if errorlevel 1 goto :error
    "%GITEXE%" remote get-url origin >nul 2>&1
    if not errorlevel 1 (
      "%GITEXE%" push
      if errorlevel 1 echo [WARN] Local update succeeded, but GitHub push failed.
    )
  )
)
echo.
echo [OK] Update complete.
timeout /t 3 /nobreak >nul
popd
endlocal
exit /b 0
:error
echo.
echo [ERROR] Update failed. See the message above.
pause
popd
endlocal
exit /b 1
goto :eof
__DEEP_LOOT_PAYLOAD__

